# Flask Configuration
FLASK_ENV=development
FLASK_DEBUG=1
PORT=5000
SECRET_KEY=change-this-in-production-use-a-strong-secret-key

# Database
# Default: SQLite in local directory. On EC2, you can specify an absolute path or RDS PostgreSQL
DATABASE_URL=sqlite:///linknest.db

# Frontend CORS origin (comma-separated if multiple, e.g. http://localhost:5173,https://your-amplify-domain.amplifyapp.com)
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# AWS S3 Configuration (Optional for local testing; needed when S3 attachments are enabled)
# If running on EC2 with an attached IAM role, AWS_ACCESS_KEY_ID and AWS_SECRET_ACCESS_KEY are NOT required.
AWS_REGION=us-east-1
S3_BUCKET_NAME=linknest-attachments-storage
# AWS_ACCESS_KEY_ID=your-access-key-here
# AWS_SECRET_ACCESS_KEY=your-secret-key-here
